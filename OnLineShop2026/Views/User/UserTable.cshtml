@model List<OnLineShop2026.Models.User>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Имя-Фамилия</th>
            <th scope="col">Почта</th>
            <th scope="col">ID</th>
        </tr>
    </thead>
    <tbody>
            @foreach (var user in Model)
            {
        <tr>

                <th scope="row"></th>
                <td>@user.Name  @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.Id</td>
                </tr>            
            }
    </tbody>
</table>