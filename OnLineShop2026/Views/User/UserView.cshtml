@model OnLineShop2026.Models.User

<div class="card" style="width: 18rem;">
    <img src="@Model.PFPPath" width="150" class="card-img-top" alt="...">
    <div class="card-body">
        <h5 class="card-title">PROFILE</h5>

    </div>
    <ul class="list-group list-group-flush">
        <li class="list-group-item">@Model.Name</li>
        <li class="list-group-item">@Model.LastName</li>
        <li class="list-group-item">@Model.Email</li>
        <li class="list-group-item">@Model.Id</li>
    </ul>

</div>